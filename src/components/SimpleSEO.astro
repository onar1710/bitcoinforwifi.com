---
export interface Props {
	title: string;
	description: string;
	image?: string;
	url?: string;
	type?: string;
	siteName?: string;
	author?: string;
	publishedTime?: string;
	modifiedTime?: string;
	category?: string;
	tags?: string[];
	keywords?: string;
}

const {
	title,
	description,
	image = '/og-image.jpg',
	url = new URL(Astro.url.pathname, Astro.site).href,
	type = 'website',
	siteName = 'BitcoinForWifi',
	author = 'BitcoinForWifi Expert',
	publishedTime,
	modifiedTime,
	category,
	tags = [],
	keywords
} = Astro.props;

const siteHref = typeof Astro.site === 'string' ? Astro.site : Astro.site?.href;
const canonicalUrl = url;
const absoluteImage = (() => {
	try {
		if (image?.startsWith('http://') || image?.startsWith('https://')) return image;
		if (!siteHref) return image;
		return new URL(image || '/og-image.jpg', siteHref).href;
	} catch {
		return image;
	}
})();

const normalizeIsoDate = (dateString?: string) => {
	if (!dateString) return undefined;
	const d = new Date(dateString);
	return Number.isNaN(d.getTime()) ? undefined : d.toISOString();
};

const isoPublishedTime = normalizeIsoDate(publishedTime);
const isoModifiedTime = normalizeIsoDate(modifiedTime || publishedTime);

const finalKeywords =
	keywords ??
	(tags.length > 0 ? tags.join(', ') : 'bitcoin, cryptocurrency, blockchain, investment');

const structuredData = (() => {
	const base = {
		"@context": "https://schema.org",
		"@type": type === 'article' ? 'BlogPosting' : 'WebSite',
		"name": title,
		"headline": title,
		"description": description,
		"url": canonicalUrl,
		"inLanguage": "en",
		"publisher": siteHref
			? {
					"@type": "Organization",
					"name": siteName,
					"url": siteHref,
					"logo": {
						"@type": "ImageObject",
						"url": new URL('/logo.svg', siteHref).href
					}
				}
			: {
					"@type": "Organization",
					"name": siteName
				}
	};

	if (type !== 'article') return base;

	return {
		...base,
		"@type": "BlogPosting",
		"image": absoluteImage
			? {
					"@type": "ImageObject",
					"url": absoluteImage
				}
			: undefined,
		"datePublished": isoPublishedTime,
		"dateModified": isoModifiedTime,
		"author": {
			"@type": "Person",
			"name": author
		},
		"articleSection": category,
		"keywords": finalKeywords,
		"mainEntityOfPage": {
			"@type": "WebPage",
			"@id": canonicalUrl
		},
		"breadcrumb": siteHref
			? {
					"@type": "BreadcrumbList",
					"itemListElement": [
						{
							"@type": "ListItem",
							"position": 1,
							"name": "Home",
							"item": siteHref
						},
						{
							"@type": "ListItem",
							"position": 2,
							"name": "Blog",
							"item": new URL('/blog', siteHref).href
						},
						{
							"@type": "ListItem",
							"position": 3,
							"name": title,
							"item": canonicalUrl
						}
					]
				}
			: undefined
	};
})();

---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="keywords" content={finalKeywords} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="theme-color" content="#f7931a" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />

{type === 'article' && author && <meta property="article:author" content={author} />}
{type === 'article' && category && <meta property="article:section" content={category} />}
{type === 'article' && isoPublishedTime && <meta property="article:published_time" content={isoPublishedTime} />}
{type === 'article' && isoModifiedTime && <meta property="article:modified_time" content={isoModifiedTime} />}
{type === 'article' && tags.map(tag => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:site" content="@bitcoinforwifi" />
<meta name="twitter:creator" content="@bitcoinforwifi" />

<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="en" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
