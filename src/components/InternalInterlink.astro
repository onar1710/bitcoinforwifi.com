---
import { getCollection } from 'astro:content';
import { getPostUrl } from '../utils/editorialRouting';
import fs from 'node:fs/promises';

export interface Props {
	entrySlug: string;
	tags?: string[];
}

const { entrySlug, tags = [] } = Astro.props;

const hashString = (value: string): number => {
	let h = 2166136261;
	for (let i = 0; i < value.length; i++) {
		h ^= value.charCodeAt(i);
		h = Math.imul(h, 16777619);
	}
	return h >>> 0;
};

const seededShuffle = <T,>(arr: T[], seedStr: string): T[] => {
	let seed = hashString(seedStr) || 1;
	const rand = () => {
		seed += 0x6d2b79f5;
		let t = seed;
		t = Math.imul(t ^ (t >>> 15), t | 1);
		t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};

	const copy = arr.slice();
	for (let i = copy.length - 1; i > 0; i--) {
		const j = Math.floor(rand() * (i + 1));
		[copy[i], copy[j]] = [copy[j], copy[i]];
	}
	return copy;
};

const clamp = (n: number, min: number, max: number): number => Math.max(min, Math.min(max, n));

const dictionaryPath = new URL('../../dicionario-interlink', import.meta.url);
const dictionaryRaw = await fs.readFile(dictionaryPath, 'utf-8');
const dictionaryPhrases = dictionaryRaw
	.split(/\r?\n/g)
	.map((l) => l.trim())
	.filter(Boolean);

const allEntries = await getCollection('blog', ({ data }) => data.published);
const currentTags = tags;

const candidates = allEntries
	.filter((e) => e.slug !== entrySlug)
	.map((e) => ({ slug: e.slug, ...e.data }))
	.filter((p) => {
		const pTags = (p.tags ?? []) as string[];
		return currentTags.length > 0 && pTags.some((t) => currentTags.includes(t));
	});

const selected = seededShuffle(candidates, entrySlug).slice(0, 7);
const phrasePool = seededShuffle(dictionaryPhrases, `${entrySlug}::phrases`);

const links = selected.map((p, idx) => {
	const phrase = phrasePool[idx % phrasePool.length] ?? 'Read more in';
	return {
		url: getPostUrl(p as any),
		title: String(p.title ?? ''),
		phrase
	};
});

const payload = {
	links,
	seed: entrySlug
};
---


<script is:inline define:vars={{ payload }}>
	(() => {
		const links = Array.isArray(payload.links) ? payload.links : [];
		if (!links.length) return;

		const root = document.querySelector('.article-content');
		if (!root) return;

		const paragraphs = Array.from(root.querySelectorAll('p'));
		if (paragraphs.length < 2) return;

		const desired = Math.max(3, Math.min(7, Math.floor(paragraphs.length / 4)));
		const count = Math.min(desired, links.length);
		if (count <= 0) return;

		const usableRangeStart = 1;
		const usableRangeEnd = Math.max(usableRangeStart, paragraphs.length - 2);
		const usableCount = usableRangeEnd - usableRangeStart + 1;
		const interval = Math.max(1, Math.floor(usableCount / (count + 1)));

		const usedUrls = new Set();
		const usedAnchors = new Set();

		let inserted = 0;
		for (let i = 1; i <= count; i++) {
			const idx = Math.min(usableRangeEnd, usableRangeStart + i * interval);
			const p = paragraphs[idx];
			if (!p) continue;

			const link = links[inserted];
			if (!link || !link.url || !link.title) continue;
			if (usedUrls.has(link.url)) continue;
			if (usedAnchors.has(link.title)) continue;

			const container = document.createElement('p');
			container.className = 'internal-interlink text-gray-300';
			container.style.marginTop = '1rem';
			container.style.marginBottom = '1rem';

			const a = document.createElement('a');
			a.href = link.url;
			a.textContent = link.title;
			a.className = 'text-bitcoin-orange hover:text-bitcoin-light transition-colors font-semibold';
			a.style.textDecoration = 'underline';
			a.style.textDecorationColor = '#000';

			container.append(document.createTextNode(`${link.phrase} `));
			container.append(a);
			container.append(document.createTextNode('.'));

			const next = p.nextElementSibling;
			if (next && next.classList && next.classList.contains('internal-interlink')) continue;

			p.insertAdjacentElement('afterend', container);
			usedUrls.add(link.url);
			usedAnchors.add(link.title);
			inserted++;
			if (inserted >= count) break;
		}
	})();
</script>
