---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntryBySlug } from 'astro:content';
import { EDITORIAL_CATEGORIES } from '../../data/blog-posts';
import { getEditorialCategorySlugForPost, getPostUrl, LEGACY_BLOG_CANONICAL_SLUGS, type EditorialCategorySlug } from '../../utils/editorialRouting';
import InternalInterlink from '../../components/InternalInterlink.astro';

const isRenderablePostImage = (value: unknown): value is string => {
	return typeof value === 'string' && value.trim().length > 0 && !value.trim().toLowerCase().endsWith('.svg');
};

export async function getStaticPaths() {
	const entries = await getCollection('blog', ({ data }) => data.published);
	const posts = entries.map((entry) => ({ slug: entry.slug, ...entry.data }));

	const editorialSlugs = new Set(EDITORIAL_CATEGORIES.map((c) => c.slug));

	return posts
		.map((post) => {
			let category: EditorialCategorySlug;
			let slug: string;
			if (post.slug.includes('/')) {
				category = post.slug.split('/')[0] as EditorialCategorySlug;
				slug = post.slug.split('/')[1];
			} else {
				category = getEditorialCategorySlugForPost(post) || 'bitcoin'; // fallback
				slug = post.slug;
			}
			if (!category || !slug || !editorialSlugs.has(category)) return null;
			return {
				params: { category, slug },
				props: { category, slug }
			};
		})
		.filter(Boolean);
}

const { category: cat, slug } = Astro.props as { category: EditorialCategorySlug; slug: string };
const isLegacy = cat === 'bitcoin' && LEGACY_BLOG_CANONICAL_SLUGS.has(slug);
const entrySlug = isLegacy ? slug : `${cat}/${slug}`;
const entry = await getEntryBySlug('blog', entrySlug);

const PostImage = (await import('../../components/PostImage.astro') as any).default;

if (!entry) {
	return Astro.redirect('/blog');
}

// If the canonical URL is still /blog/<slug> (legacy indexed posts), redirect away
// from /<category>/<slug> to avoid duplicate content.
const canonicalUrl = getPostUrl({ slug, ...entry.data });
if (canonicalUrl === `/blog/${slug}`) {
	return Astro.redirect(canonicalUrl);
}

const { title, description, date, readTime, category, author, image, tags, modifiedTime } = entry.data;
const renderResult = await entry.render();

const pageImage = isRenderablePostImage(image) ? image : undefined;

const hashString = (value: string): number => {
	let h = 2166136261;
	for (let i = 0; i < value.length; i++) {
		h ^= value.charCodeAt(i);
		h = Math.imul(h, 16777619);
	}
	return h >>> 0;
};

const seededShuffle = (arr: any[], seedStr: string): any[] => {
	let seed = hashString(seedStr) || 1;
	const rand = () => {
		seed += 0x6D2B79F5;
		let t = seed;
		t = Math.imul(t ^ (t >>> 15), t | 1);
		t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};

	const copy = arr.slice();
	for (let i = copy.length - 1; i > 0; i--) {
		const j = Math.floor(rand() * (i + 1));
		[copy[i], copy[j]] = [copy[j], copy[i]];
	}
	return copy;
};

const relatedEntries = await getCollection('blog', ({ data }) => data.published);
const relatedArticles = relatedEntries
	.map((e) => ({ slug: e.slug, ...e.data }))
	.filter((p) => p.slug !== entrySlug)
	.filter((p) => {
		const sameCategory = Boolean(category) && p.category === category;
		const currentTags = (tags ?? []) as string[];
		const pTags = (p.tags ?? []) as string[];
		const sharedTags = currentTags.length > 0 && pTags.some((t) => currentTags.includes(t));
		return sameCategory || sharedTags;
	})
	.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const relatedArticlesRandom = seededShuffle(relatedArticles, entrySlug).slice(0, 6);
---

<Layout
	title={title}
	type="article"
	description={description}
	image={pageImage}
	category={category}
	keywords={entry.data.keywords}
	tags={tags}
	publishedTime={date}
	modifiedTime={modifiedTime}
>
	<article class="py-20">
		<div class="container mx-auto px-4 max-w-4xl">
			<header class="mb-12">
				{pageImage && (
					<div class="mb-8">
						<img src={pageImage} alt={title} loading="eager" class="w-full h-auto rounded-lg border border-dark-border bg-dark" />
					</div>
				)}

				<h1 class="text-4xl md:text-5xl font-bold mb-6">
					<span class="gradient-text">{title}</span>
				</h1>

				<div class="flex items-center space-x-4 p-4 bg-dark-card border border-dark-border rounded-lg mb-4">
					<div class="w-12 h-12 bg-bitcoin-orange/20 rounded-full flex items-center justify-center">
						<svg class="w-6 h-6 text-bitcoin-orange" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
						</svg>
					</div>
					<div>
						<div class="font-semibold">{author}</div>
						<div class="text-sm text-gray-400">Expert Bitcoin Analyst</div>
					</div>
				</div>

				<div class="flex items-center space-x-2 text-sm text-gray-400">
					<span class="px-3 py-1 bg-bitcoin-orange text-white text-xs font-semibold rounded-full">{category}</span>
					<time datetime={date}>
						{new Date(date).toLocaleDateString('en-US', {
							year: 'numeric',
							month: 'long',
							day: 'numeric'
						})}
					</time>
					<span>•</span>
					<span>{readTime}</span>
				</div>
			</header>

			<div class="article-content prose prose-invert max-w-none"><renderResult.Content /></div>
			{(tags ?? []).length > 0 && <InternalInterlink entrySlug={entrySlug} tags={tags as any} />}

			<div class="mt-12 pt-8 border-t border-dark-border">
				<h3 class="text-lg font-semibold mb-4">Tags</h3>
				<div class="flex flex-wrap gap-2">
					{(tags ?? []).map((tag: string) => (
						<span class="px-3 py-1 bg-dark border border-dark-border text-gray-300 text-sm rounded-full hover:border-bitcoin-orange hover:text-bitcoin-orange transition-colors cursor-pointer">
							{tag}
						</span>
					))}
				</div>
			</div>

			<div class="mt-12 pt-8 border-t border-dark-border">
				<h3 class="text-lg font-semibold mb-4">Share</h3>
				<div class="flex space-x-4">
					<button class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
						Share on Twitter
					</button>
					<button class="px-4 py-2 bg-blue-800 text-white rounded-lg hover:bg-blue-900 transition-colors">
						Share on Facebook
					</button>
					<button class="px-4 py-2 bg-gray-700 text-white rounded-lg hover:bg-gray-800 transition-colors">
						Copy Link
					</button>
				</div>
			</div>

			{relatedArticlesRandom.length > 0 && (
				<div class="mt-16 pt-8 border-t border-dark-border">
					<h3 class="text-2xl font-bold mb-8">
						<span class="gradient-text">Related Articles</span>
					</h3>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
						{relatedArticlesRandom.map((relatedPost) => (
							<article class="bg-dark-card border border-dark-border rounded-lg p-6 card-hover">
								<a href={getPostUrl(relatedPost)} class="block mb-4">
									<PostImage
										src={relatedPost.image}
										alt={relatedPost.title}
										loading="lazy"
										class="w-full h-32 object-cover rounded-lg border border-dark-border bg-dark"
									/>
								</a>
								<h4 class="text-lg font-semibold mb-3 hover:text-bitcoin-orange transition-colors">
									<a href={getPostUrl(relatedPost)}>{relatedPost.title}</a>
								</h4>
								<p class="text-gray-400 mb-3">{relatedPost.description}</p>
								<a href={getPostUrl(relatedPost)} class="inline-flex items-center text-bitcoin-orange hover:text-bitcoin-light transition-colors font-semibold">
									Read me
								</a>
								<div class="text-sm text-gray-500">{relatedPost.readTime}</div>
							</article>
						))}
					</div>
				</div>
			)}
		</div>
	</article>
</Layout>
